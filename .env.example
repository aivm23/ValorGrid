# Optional local overrides. Copy to .env or set environment variables manually.
# Never commit .env files with personal paths or credentials.

HOST=127.0.0.1
PORT=1325

# Optional. Bind interface for `docker compose` port publishing
# (deploy/docker/docker-compose.yml). Defaults to loopback when unset.
# BIND_IP=127.0.0.1

# Optional. If unset, the app uses local/valorgrid/data/portfolio.sqlite.
# PORTFOLIO_DB_PATH=C:\path\to\your\portfolio.sqlite

# Optional. If unset, backups use local/valorgrid/backups/.
# The Windows desktop app sets this automatically to its user data folder.
# VALORGRID_BACKUP_DIR=C:\path\to\your\backups

# Optional. Encrypts CLI backups as .sqlite.enc (scrypt + AES-256-GCM, no extra
# dependencies). The passphrase is only read from this variable, never from
# argv, and is not stored by the app. Minimum 8 characters.
# VALORGRID_BACKUP_ENCRYPT=1
# VALORGRID_BACKUP_PASSPHRASE=pon-aqui-una-frase-larga
